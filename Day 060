#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int *data;
    int front, rear;
} Deque;

void initDeque(Deque *dq, int n) {
    dq->data = (int *)malloc(n * sizeof(int));
    dq->front = dq->rear = -1;
}

int isEmpty(Deque *dq) {
    return dq->front == -1;
}

void pushRear(Deque *dq, int value) {
    if (dq->front == -1)
        dq->front = dq->rear = 0;
    else
        dq->rear++;
    dq->data[dq->rear] = value;
}

void popFront(Deque *dq) {
    if (dq->front == dq->rear)
        dq->front = dq->rear = -1;
    else
        dq->front++;
}

void popRear(Deque *dq) {
    if (dq->front == dq->rear)
        dq->front = dq->rear = -1;
    else
        dq->rear--;
}

int front(Deque *dq) {
    return dq->data[dq->front];
}

int rear(Deque *dq) {
    return dq->data[dq->rear];
}

int main() {
    int n, k;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Enter window size k: ");
    scanf("%d", &k);

    Deque dq;
    initDeque(&dq, n);
    for (int i = 0; i < k; i++) {
        while (!isEmpty(&dq) && arr[rear(&dq)] <= arr[i])
            popRear(&dq);
        pushRear(&dq, i);
    }
    for (int i = k; i < n; i++) {
        printf("%d ", arr[front(&dq)]);
        if (!isEmpty(&dq) && front(&dq) <= i - k)
            popFront(&dq);
        while (!isEmpty(&dq) && arr[rear(&dq)] <= arr[i])
            popRear(&dq);

        pushRear(&dq, i);
    }

    // Print max of last window
    printf("%d\n", arr[front(&dq)]);

    return 0;
}
