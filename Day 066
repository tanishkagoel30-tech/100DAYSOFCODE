#include <stdio.h>

int main() {
    int n, target;
    scanf("%d", &n);

    int nums[n];
    for(int i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    scanf("%d", &target);
    int hash[100000] = {0};  

    for(int i = 0; i < n; i++) {
        int complement = target - nums[i];

        if (complement > 0 && hash[complement] != 0) {
            printf("%d %d", hash[complement] - 1, i);
            return 0;
        }

        hash[nums[i]] = i + 1;  
    }

    printf("-1 -1");
    return 0;
}
