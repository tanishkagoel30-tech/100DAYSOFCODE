#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int seen[100000] = {0};  

    for(int i = 0; i < n; i++) {
        if(seen[arr[i]] == 1) {
            printf("%d", arr[i]);
            return 0;
        }
        seen[arr[i]] = 1;
    }

    return 0;
}
